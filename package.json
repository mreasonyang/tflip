{
  "name": "@kyun.si/tflip",
  "version": "0.3.2",
  "description": "Tflip: framework-independent 3D roll, flight and landing motion with optional Canvas effects and React bindings.",
  "private": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:agent": "npm run build && node scripts/build-agent-kit.mjs",
    "preview:sync": "npm run build:agent && node scripts/sync-preview.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:agent && npm run test:types && node --test tests/*.test.mjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:browser": "node --test --test-concurrency=1 tests/*.e2e.mjs",
    "dev": "node scripts/serve.mjs",
    "pack:local": "npm run build:agent && node scripts/pack-local.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "test:all": "npm test && npm run test:browser",
    "release:prepare": "npm run test:all && npm run preview:sync && node scripts/release-artifacts.mjs",
    "test:consumer:prepare": "node scripts/build-consumer-fixture.mjs"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mreasonyang/tflip.git"
  },
  "homepage": "https://tflip.kyun.si",
  "bugs": {
    "url": "https://github.com/mreasonyang/tflip/issues"
  }
}
